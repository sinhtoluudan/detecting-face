# Manual Python launch with a local MongoDB server.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=facecam_attendance
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
SEED_DEMO=true
DEMO_PASSWORD=Demo@123456
# Set true only after installing requirements-face.txt.
FACE_ENABLED=false
FACE_THRESHOLD=0.50
FACE_MARGIN=0.08
