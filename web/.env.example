# Docker Compose: copy this file to .env before running.
WEB_PORT=3000
API_PORT=8000
# 27019 avoids common existing MongoDB ports 27017/27018.
MONGO_PORT=27019
MONGO_USER=facecam
MONGO_PASSWORD=LocalMongoChangeMe123
MONGO_DB=facecam_attendance
SEED_DEMO=true
DEMO_PASSWORD=Demo@123456
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Build optional face libraries; first face request downloads buffalo_l (~300MB).
INSTALL_FACE=true
FACE_ENABLED=true
FACE_THRESHOLD=0.50
FACE_MARGIN=0.08
